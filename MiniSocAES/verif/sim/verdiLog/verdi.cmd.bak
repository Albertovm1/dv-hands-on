wvScrollDown -win $_nWave2 0
wvScrollDown -win $_nWave2 0
wvScrollDown -win $_nWave2 0
wvScrollDown -win $_nWave2 0
wvSetCursor -win $_nWave2 1999.177517 -snap {("G1" 2)}
wvSetCursor -win $_nWave2 15136.629774 -snap {("G1" 2)}
wvSetCursor -win $_nWave2 19706.178385 -snap {("G1" 2)}
srcActiveTrace "minisoc_top_tb.rst_vif.rst_n" -TraceByDConWave -TraceTime 750 \
           -TraceValue 0 -win $_nTrace1
wvScrollDown -win $_nWave2 0
wvZoomIn -win $_nWave2
wvZoomIn -win $_nWave2
wvZoomIn -win $_nWave2
wvZoomIn -win $_nWave2
wvScrollDown -win $_nWave2 0
wvScrollDown -win $_nWave2 0
